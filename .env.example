# Copiá este archivo como .env.local (no se versiona).
# Todo lo que empieza con VITE_ queda dentro del JavaScript publicado: solo valores PÚBLICOS, nunca secretos.

# URL base de Handy-landing-page-be, sin barra final. Vacía = "Registro habilitado en breve".
# En GitHub Pages se toma de la variable del repo FORM_ENDPOINT (ver .github/workflows/deploy.yml).
VITE_FORM_ENDPOINT=

# Ruta base del sitio. Vacía = /Handy-landing-page-fe/ (GitHub Pages).
# Para publicar en la raíz de un dominio (Hostinger, https://handyc.com): VITE_BASE=/
VITE_BASE=
